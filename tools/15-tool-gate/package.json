{
  "name": "dsh-tool-gate",
  "version": "0.1.0",
  "description": "按组隐藏工具，用 tool_gate 现开现用。省的是每轮的工具定义 token。",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "tool-groups.json",
    "README.md"
  ],
  "dsh": {
    "category": "extension",
    "displayName": "Tool Gate",
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "keywords": [
    "dsh-plugin",
    "tools",
    "lazy"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  }
}
