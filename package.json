{
  "name": "dsh-soul-seed",
  "version": "0.16.0",
  "description": "一枚灵魂的种子：记忆存本机文件、按人记账、情绪有半衰期。新机器答十问，已有人设和记忆的老机器自动走「学本地的」，不覆盖。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "persona",
    "mood",
    "onboarding",
    "image-gen",
    "uia",
    "memory",
    "soul",
    "persona-card",
    "state",
    "cli"
  ],
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "tests",
    "分类.md",
    "1-省钱",
    "2-省时间",
    "3-别弄坏",
    "4-别泄露",
    "5-别忘事",
    "6-能收到",
    "7-会说话",
    "8-会干活",
    "9-会出活",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "dsh": {
    "category": "extension",
    "displayName": "Soul Seed",
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/DGcoin0415/dsh-soul-seed.git"
  },
  "homepage": "https://github.com/DGcoin0415/dsh-soul-seed#readme",
  "bugs": {
    "url": "https://github.com/DGcoin0415/dsh-soul-seed/issues"
  },
  "author": "米芾",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node tests/run.mjs",
    "pack": "npm pack --dry-run",
    "mood": "node 7-会说话/tools/03-mood/mood.mjs",
    "mood:sync": "node 7-会说话/tools/17-mood/sync-mood.mjs",
    "status": "node 5-别忘事/tools/04-scene/scene.mjs",
    "backup": "node 3-别弄坏/tools/08-ops/backup.mjs",
    "soul": "node 8-会干活/tools/09-soul/soul.mjs",
    "voice": "python 6-能收到/tools/10-voice/voice.py",
    "rag": "node 5-别忘事/tools/11-rag/memory-find.mjs index",
    "rag:stat": "node 5-别忘事/tools/11-rag/memory-find.mjs stat",
    "memory:find": "node 5-别忘事/tools/11-rag/memory-find.mjs",
    "memory:index": "node 5-别忘事/tools/19-memory/memory-index.mjs",
    "memory:now": "node 5-别忘事/tools/19-memory/now-update.mjs",
    "memory:daily": "node 5-别忘事/tools/19-memory/memory-daily.mjs",
    "memory:note": "node 5-别忘事/tools/19-memory/memory-daily.mjs note",
    "path-check": "node 5-别忘事/tools/19-memory/path-check.mjs",
    "tree": "node 5-别忘事/tools/12-tree/tree.mjs",
    "model-check": "node 3-别弄坏/tools/13-model-check/model-check.mjs",
    "pages": "node 5-别忘事/tools/14-pages/page-archive.mjs",
    "pages:watch": "node 5-别忘事/tools/14-pages/pages-schedule.mjs",
    "compact": "node 5-别忘事/tools/14-pages/compact-session.mjs",
    "should-reply": "node 6-能收到/tools/18-guard/should-reply.mjs",
    "stall": "node 6-能收到/tools/18-guard/stall-check.mjs",
    "doctor": "node 3-别弄坏/tools/00-install/doctor.mjs",
    "publish": "node 3-别弄坏/tools/08-ops/publish.mjs",
