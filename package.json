{
  "name": "dsh-soul-seed",
  "version": "0.12.8",
  "description": "一枚灵魂的种子。种下去它不等人叫 —— 白天数着光，夜里数着潮；屏幕暗着，灯丝还红着。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "persona",
    "mood",
    "onboarding",
    "image-gen",
    "uia",
    "memory",
    "soul",
    "persona-card",
    "state",
    "cli"
  ],
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "tools",
    "tests",
    "docs",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "dsh": {
    "category": "extension",
    "displayName": "Soul Seed",
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/DGcoin0415/dsh-soul-seed.git"
  },
  "homepage": "https://github.com/DGcoin0415/dsh-soul-seed#readme",
  "bugs": {
    "url": "https://github.com/DGcoin0415/dsh-soul-seed/issues"
  },
  "author": "米芾",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node tests/run.mjs",
    "pack": "npm pack --dry-run",
    "mood": "node tools/03-mood/mood.mjs",
    "mood:sync": "node tools/17-mood/sync-mood.mjs",
    "status": "node tools/04-scene/scene.mjs",
    "backup": "node tools/08-ops/backup.mjs",
    "soul": "node tools/09-soul/soul.mjs",
    "voice": "python tools/10-voice/voice.py",
    "rag": "node tools/11-rag/rag.mjs",
    "memory:find": "node tools/11-rag/memory-find.mjs",
    "memory:index": "node tools/19-memory/memory-index.mjs",
    "memory:now": "node tools/19-memory/now-update.mjs",
    "memory:daily": "node tools/19-memory/memory-daily.mjs",
    "path-check": "node tools/19-memory/path-check.mjs",
    "tree": "node tools/12-tree/tree.mjs",
    "model-check": "node tools/13-model-check/model-check.mjs",
    "pages": "node tools/14-pages/page-archive.mjs",
    "pages:watch": "node tools/14-pages/pages-schedule.mjs",
    "compact": "node tools/14-pages/compact-session.mjs",
    "should-reply": "node tools/18-guard/should-reply.mjs",
    "stall": "node tools/18-guard/stall-check.mjs"
  }
}
